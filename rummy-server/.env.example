# v3.0.0 Hidden Backbone — Supabase persistence.
#
# Both vars must be set for the server to leave Ephemeral Mode. The
# service role key bypasses RLS and is the ONLY credential the server
# uses; never ship this to the client.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJI... # service_role JWT, server-only

# Existing knobs.
PORT=10000
FRONTEND_URL=https://your-frontend.example.com
